    {
      "title": "Плотность скоров · выбранный сегмент",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "description": "Оценка плотности: count / (N × 0.05). Площадь столбцов равна 1. Учитываются период, штат и мерчант.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "\nWITH selected AS (SELECT least(floor(score * 20)::int, 19) AS bin FROM scores WHERE $__timeFilter(scored_at) AND us_state IN (${us_state:sqlstring}) AND merch IN (${merch:sqlstring})),\ncounts AS (SELECT bin, count(*) AS n FROM selected GROUP BY bin)\nSELECT to_char(b.bin * 0.05, '0.00') || '–' || to_char((b.bin + 1) * 0.05, '0.00') AS \"score\",\n       coalesce(c.n, 0)::double precision / nullif((SELECT count(*) FROM selected) * 0.05, 0) AS \"Плотность\"\nFROM generate_series(0, 19) b(bin) LEFT JOIN counts c USING (bin) ORDER BY b.bin\n",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "xTickLabelRotation": -20,
        "showValue": "auto",
        "groupWidth": 0.8,
        "barWidth": 0.9
      },
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "TPS · выбранный сегмент",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "description": "Число уникальных транзакций / 10 секунд. Только полные интервалы; пропуски заполнены нулями.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "\nWITH buckets AS (\n SELECT generate_series(to_timestamp(ceil(extract(epoch FROM $__timeFrom()::timestamptz) / 10) * 10),\n to_timestamp(floor(extract(epoch FROM $__timeTo()::timestamptz) / 10) * 10 - 10), interval '10 seconds') AS time\n), counts AS (\n SELECT to_timestamp(floor(extract(epoch FROM scored_at) / 10) * 10) AS time, count(*) / 10.0 AS tps\n FROM scores WHERE $__timeFilter(scored_at) AND us_state IN (${us_state:sqlstring}) AND merch IN (${merch:sqlstring}) GROUP BY 1\n)\nSELECT b.time AS \"time\", coalesce(c.tps, 0)::double precision AS \"TPS\" FROM buckets b LEFT JOIN counts c USING (time) ORDER BY 1\n",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      }
    },
    {
      "title": "Фрод по категории · последние 1000 транзакций",
      "type": "barchart",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "description": "Общие последние 1000 записей потока независимо от фильтров и периода. Если записей меньше, используются все имеющиеся.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "\nWITH recent AS (SELECT cat_id, fraud_flag FROM scores ORDER BY scored_at DESC, transaction_id DESC LIMIT 1000)\nSELECT cat_id, avg(fraud_flag)::double precision AS \"Доля фрода\" FROM recent GROUP BY cat_id ORDER BY 2 DESC\n",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
