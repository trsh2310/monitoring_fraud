            "uid": "postgres"
          },
          "rawSql": "SELECT merch AS \"Мерчант\", sum(amt * fraud_flag) AS \"Подозрительная сумма, USD\" FROM scores WHERE $__timeFilter(scored_at) AND us_state IN (${us_state:sqlstring}) AND merch IN (${merch:sqlstring}) GROUP BY merch ORDER BY 2 DESC",
